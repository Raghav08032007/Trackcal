{$APP_DOMAIN} {
	request_body {
		max_size 15MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
	}

	# The Flask API serves the browser routes (/api/*) and the versioned API (/api/v1/*). Caddy appends the
	# client address to X-Forwarded-For; the API trusts exactly that one entry (TRUSTED_PROXY_HOPS=1).
	handle /api/* {
		# JSON only: nothing in an API response may run, load or be framed.
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:8000
	}
	# Scheduler trigger and metrics: the API refuses requests without the X-Tick-Secret header.
	handle /internal/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
