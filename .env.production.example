# Copy to .env.production; never commit real values. Use your own domain at deployment time.
APP_DOMAIN=trackcal.example.com
APP_SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
APP_ENV=production
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
DAILY_AI_LIMIT=15
# Days between closing an account and its permanent erasure (0-365). Owner decision; state it in the privacy notice.
ACCOUNT_ERASURE_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional private household/media services, reachable from the API container:
GROCY_URL=
GROCY_API_KEY=
MEALIE_URL=
MEALIE_API_KEY=
INTEGRATION_OWNER_ID=
PADDLEOCR_URL=
# Notifications (Phase 4/H): VAPID keys for web push, and the scheduler secret (32+ random characters) that POST /internal/tick needs.
FEATURE_WEB_PUSH=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain
TICK_SECRET=
# Premium through Razorpay (docs/BILLING.md). Start with Test Mode keys (rzp_test_...); never set RAZORPAY_SIMULATED here.
FEATURE_BILLING=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=
# Seconds a ranked food search is kept (Phase I). 600 by default in production; 0 turns it off.
FOOD_SEARCH_CACHE_SECONDS=600
