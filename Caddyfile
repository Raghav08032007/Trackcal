# Serves the built Vite app inside the private network. The public edge (infrastructure/Caddyfile) adds HTTPS,
# security headers and routes /api/* to the Flask API.
:3000 {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change; everything else must be revalidated so updates reach users.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# The pose model and runtime live in a versioned folder (/pose/<version>/), so they can be cached for a year too.
	@model path /pose/*
	header @model Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/* /pose/*
	header @fresh Cache-Control "no-cache"

	# Client-side routes fall back to the app shell; real files (offline.html, sw.js, pose models) are served as-is.
	try_files {path} /index.html
	file_server
}
