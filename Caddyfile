# Serves the built Vite app inside the private network. The public edge (infrastructure/Caddyfile) adds HTTPS,
# security headers and routes /api/* to the Flask API.
:3000 {
	root * /srv
	encode zstd gzip

	# Content Security Policy: the single source (vite preview reads this line too, so tests run under it).
	# wasm-unsafe-eval: the on-device pose model (WebAssembly). Razorpay: checkout script, frames and API only.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://checkout.razorpay.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; media-src 'self' blob: mediastream:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header Cross-Origin-Opener-Policy "same-origin-allow-popups"

	# Hashed build assets never change; everything else must be revalidated so updates reach users.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# The pose model and runtime live in a versioned folder (/pose/<version>/), so they can be cached for a year too.
	@model path /pose/*
	header @model Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/* /pose/*
	header @fresh Cache-Control "no-cache"

	# Client-side routes fall back to the app shell; real files (offline.html, sw.js, pose models) are served as-is.
	try_files {path} /index.html
	file_server
}
