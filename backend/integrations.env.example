# Add values to backend/.env. Never place service credentials in NEXT_PUBLIC_* variables.
GROCY_URL=http://127.0.0.1:9283
GROCY_API_KEY=
MEALIE_URL=http://127.0.0.1:9000
MEALIE_API_KEY=
# Account UUID allowed to read the configured household. Admin accounts are also allowed.
INTEGRATION_OWNER_ID=
PADDLEOCR_URL=http://127.0.0.1:8011
# Leave empty to use the local pywhispercpp CPU runtime and downloaded tiny model.
WHISPER_URL=
WGER_URL=https://wger.de
