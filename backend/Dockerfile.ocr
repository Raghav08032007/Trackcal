FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-ocr.txt .
RUN pip install --no-cache-dir -r requirements-ocr.txt
COPY services/ocr_worker.py services/ocr_worker.py
ENV PADDLE_HOME=/app/runtime/paddle PADDLE_PDX_CACHE_HOME=/app/runtime/paddlex
# One sync worker: the model is single-tenant and the handler already refuses concurrent work (429).
CMD ["gunicorn", "services.ocr_worker:app", "--bind", "0.0.0.0:8011", "--workers", "1", "--timeout", "120", "--error-logfile", "-"]
