# ============================================================
# Global AI Food Intelligence Platform — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=foodai_app
DB_PASSWORD=YOUR_SECURE_PASSWORD
DB_NAME=global_food_ai

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,exp://localhost:8081

# --- AI Providers (set whichever you have access to) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
DAILY_AI_LIMIT=15
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Nutrition APIs ---
USDA_API_KEY=DEMO_KEY
OPEN_FOOD_FACTS_APP_NAME=GlobalFoodAI
OPEN_FOOD_FACTS_APP_VERSION=1.0.0
OPEN_FOOD_FACTS_APP_CONTACT=dev@yourapp.com

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# For future cloud migration:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# --- Redis (optional, for background tasks) ---
REDIS_URL=redis://localhost:6379

# --- Email ---
PUBLIC_APP_URL=http://127.0.0.1:3002
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Feature Flags ---
ENABLE_VOICE_LOGGING=true
ENABLE_OCR_SCANNING=true
ENABLE_BARCODE_SCANNING=true
ENABLE_RESTAURANT_MODE=true
AI_MOCK_MODE=false
